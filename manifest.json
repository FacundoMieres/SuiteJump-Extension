{
  "manifest_version": 3,
  "name": "SuiteJump",
  "short_name": "SuiteJump",
  "version": "1.0.0",
  "default_locale": "es",
  "description": "__MSG_extDescription__",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.netsuite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SuiteJump",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdOpen__"
    }
  }
}
